          Name:"The seal",
          Priority:80,
          Texts:[
            {
              Text:"The seal will open for you. Keeper Zarn waits at the Inferno's gate behind me.

Keep the drifting shield between you and Zuk when his eyes burn, and strike his menders before they mend him."
            }
          ],
          Conditions:[
            {
              Type:"PLAYER_TAG",
              Name:"q_ash_done"
            }
          ],
          Buttons:[
            {
              Label:"ash_wait_0",
              Name:"Goodbye",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
