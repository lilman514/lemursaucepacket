          Label:"pits_go",
          Name:"Kiln Hollow",
          Priority:40,
          Texts:[
            {
              Text:"Follow the Kilnfolk Pass to Kiln Hollow and speak to Elder Ashka. And take a good shield: their champion breathes fire."
            }
          ],
          Conditions:[
            {
              Type:"PLAYER_TAG",
              Name:"q_pits_started"
