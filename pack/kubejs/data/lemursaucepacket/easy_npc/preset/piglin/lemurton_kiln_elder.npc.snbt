          Name:"Infernal",
          Priority:90,
          Texts:[
            {
              Text:"Kiln-Kal-Zuk is ash, and an outsider wears the Infernal Cape. The Kilnfolk will sing of you, @initiator, for as long as the mountains burn."
            }
          ],
          Conditions:[
