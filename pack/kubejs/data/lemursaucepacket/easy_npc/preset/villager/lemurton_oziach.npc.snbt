                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"ds_intro",
          Name:"Elvarg",
          Priority:20,
          Texts:[
            {
              Text:"So the Guild sent you. You want to slay Elvarg? Many have tried. She lives on Crandor, an isle no captain will sail to any more, and the only map to it was torn in three.

Find the three pieces and bring them here. And get an anti-dragon shield from the mayor: her breath will cook you in your armour without one."
            }
          ],
          Conditions:[
            {
              Type:"PLAYER_TAG",
              Name:"q_ds_started"
            }
          ],
          Buttons:[
            {
              Label:"ds_intro_0",
              Name:"I'll do it",
              Actions:[
                {
                  Type:"COMMAND",
                  Cmd:"/tag @initiator add q_ds_oziach"
                },
                {
                  Type:"OPEN_NAMED_DIALOG",
                  Cmd:"ds_where"
                }
              ]
            },
            {
              Label:"ds_intro_1",
              Name:"Maybe later",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"ds_where",
          Name:"The pieces",
          Priority:-1,
          Texts:[
            {
              Text:"One piece is with Lucan the Jeweller: he bought it off a sailor and he'll want paying. One is with Wizard Traiborn in his tower by the wall. The third is the Champions' Guild's: pass its trial (your quest book says how) and it's yours."
            }
          ],
          Buttons:[
            {
              Label:"ds_where_0",
              Name:"I'm on it",
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"ds_pieces_missing",
