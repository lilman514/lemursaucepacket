structures/raw/
structures/raw-import/
structures/raw-import2/
# Other mods' jars, cached by structures/external.mjs
structures/.external/
structures/baked/
structures/previews/

# Raw third-party material behind research/ (mod lang files, Modrinth texts, upstream sources, jar scans): kept locally only.
research/.local/
