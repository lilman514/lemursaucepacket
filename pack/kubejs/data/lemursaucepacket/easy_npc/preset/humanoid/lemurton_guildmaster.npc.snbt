                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"default",
          Name:"The Champions' Guild",
          Priority:10,
          Texts:[
            {
              Text:"Welcome to the Champions' Guild. Only the realm's finest adventurers drink here."
