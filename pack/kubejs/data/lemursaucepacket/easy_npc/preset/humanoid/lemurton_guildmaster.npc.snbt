                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"ds_go",
          Name:"Oziach",
          Priority:20,
          Texts:[
            {
              Text:"Have you spoken to Oziach? He keeps the armoury on the ring street. He knows more about dragons than any man living."
            }
          ],
          Conditions:[
            {
              Type:"PLAYER_TAG",
              Name:"q_ds_started"
            }
          ],
          Buttons:[
            {
              Label:"ds_go_0",
