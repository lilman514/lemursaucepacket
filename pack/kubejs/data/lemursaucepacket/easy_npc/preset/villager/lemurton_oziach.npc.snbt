        {
          Label:"ds_head",
          Name:"Her head?",
          Priority:50,
          Texts:[
            {
              Text:"You've the look of someone who's been to Crandor. Well? Did you bring me her head?"
            }
          ],
          Conditions:[
            {
              Type:"PLAYER_TAG",
              Name:"q_ds_elvarg"
            }
          ],
          Buttons:[
            {
