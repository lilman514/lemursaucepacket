              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                }
              ]
            }
          ]
        },
        {
          Label:"ds_map",
          Name:"Crandor",
          Priority:40,
          Texts:[
            {
              Text:"Follow that map to Crandor. Kill Elvarg and bring me her head. Hold your shield up when she breathes."
            }
          ],
          Conditions:[
            {
              Type:"PLAYER_TAG",
              Name:"q_ds_map"
